# Ha van hiányzó adat, akkor az oszlop mediánjával pótolni azokat.  
pca_df_clean <- pca_df %>%  
  mutate(across(everything(), ~ ifelse(is.na(.), median(., na.rm = TRUE), .)))

pca <- prcomp(pca_df_clean, scale = TRUE)

  
summary(pca)  
names(pca)  
# Eigenértékek lekérése  
eigenvalues <- pca$sdev^2  
eigenvalues

# Ezek mire is valók? Néhány infót kapok a PCA eredményekről?  
