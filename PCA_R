# 3. Fájl kiválasztása
df <- read_excel("FACE 2019_2.xlsx")

# 4. Adat szűkítés, ha csak bizonyos sorok kellenek.  
df <- df[c(3:26),]

# 5. ADATTÍPUSOK optimalizálása (faktorok, numerikusok) # Ezzel van amelyik kódot átnvezzük: N ->Nemere  
df <- df %>%  
  mutate(  
    # Kategória változók faktorrá alakítása (ANOVA-hoz)  
    co2_level = factor(co2_level, levels = c("FACE", "Kontrol")),  
    n_level = factor(n_level, levels = c("High", "Low")),  
    cultivar = factor(cultivar, levels = c("Nemere", "Dandár")),  
    
    # Minden többi numerikusra (hullámhosszak, kémiai paraméterek)  
    across(c("Gyökér biomassza":"Hossz/Tömeg"), as.numeric),  
    
    # sample_i megtartása karakterként (mintaazonosító)  
    sample_i = as.character("2019")  
  )  

# ellenőrzés  
str(df)  

# Kívánt oszlopok nevei  
#az összes, nem numerikus oszlop eltávolítása PCA-ra.  
# 3. csak az első 24 sor, és csak numerikus és factor oszlopok  
pca_df <- df[c(1:24), sapply(df, function(x) is.numeric(x))]

# 7. PCA - futtatás  
#Libraries   
# install.packages("vegan")  
# install.packages("ggfortify")  
# install.packages("factoextra")

# I. [https://www.youtube.com/watch?v=mNpBrHwOCt4&list=WL&t=351](https://www.youtube.com/watch?v=mNpBrHwOCt4&list=WL&t=351 "https://www.youtube.com/watch?v=mNpBrHwOCt4&list=WL&t=351")  
library(MASS)
library(factoextra)  
library(ggplot2)

# Ha nincs hiányzó adat  
# pca<-prcomp(pca_df, scale = TRUE)

# Ha van hiányzó adat, akkor az oszlop mediánjával pótolni azokat.  
pca_df_clean <- pca_df %>%  
  mutate(across(everything(), ~ ifelse(is.na(.), median(., na.rm = TRUE), .)))

pca <- prcomp(pca_df_clean, scale = TRUE) # "scale = TRUE"-val elvégzi a Z-standardizálást. 
  # center = TRUE: Ez alapból TRUE a prcomp function-ban, ezért nem látszik. Minden változóból levonja az átlagot. 


summary(pca)  
names(pca)  

# 4?. Alapellenőrzés a PCA előtt
# Érdemes megnézni a változók szórását és korrelációját.
apply(pca_df_clean, 2, sd)
cor_mat <- cor(pca_df_clean)
cor_mat
# Ha sok a közel 0 korreláció, a PCA kevésbé lesz informatív. Ha erős a kollinearitás, az viszont kifejezetten jó jel a PCA számára.
