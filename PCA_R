# II. Bekarikázós PCA-hoz  
# [https://www.youtube.com/watch?v=QJARK5WQabA](https://www.youtube.com/watch?v=QJARK5WQabA "https://www.youtube.com/watch?v=QJARK5WQabA")  
# [https://www.youtube.com/watch?v=PQf9csxkDYQ](https://www.youtube.com/watch?v=PQf9csxkDYQ "https://www.youtube.com/watch?v=PQf9csxkDYQ")

# LOAD LIBRARIES  
library(readxl) # Excel beolvasáshoz kéne?  
library(vegan)  
library(ggplot2)  
library(factoextra)  
library(ggfortify)  
library(ggrepel)

  
# pca <- rda(decostand(pca_df, method = "hellinger"), scale = TRUE, center = TRUE) # Így más lett a pca, mint a fentebbi verzió

# PRCOMP package  
# Hellinger transformation  
pca.prcomp.h <- decostand(pca_df, "hellinger")  
pca.prcomp <- prcomp(pca.prcomp.h, scale. = TRUE, center = TRUE)  
pca.prcomp

# Eigenértékek lekérése  
eig.val <- get_eigenvalue(pca.prcomp)  
eig.val

# Result for variables  
var <- get_pca_var(pca.prcomp)  
var

# Quality ellenőrzések. ... A videóban bővebben  
pca.prcomp.extract.varcoord <- var$coord 

# Results for individuals (plot)  
ind <- get_pca_ind(pca.prcomp)  
ind

pca.prcomp.extract.indcoord <- ind$coord 

# BEKARIKAZOS MEGOLDAS  
pca.plot <- ggplot(df, aes(x=plotx, y=ploty, color=co2_level)) +  
  geom_point()+  
  ggtitle("FACE PCA")+  
  xlab("PC1")+ylab("PC2")+  
  coord_fixed(ratio = 1)+  
  theme_bw() + theme(aspect.ratio = 1) + theme(panel.grid = element_blank()) +   
  stat_ellipse(geom = "polygon", aes(fill = after_scale(alpha(colour, 0.3))),  
               data = df[df$co2_level != "vesicolor",])

pca.plot

# Scree Plot ###  
screeplot(pca.prcomp, bstick = TRUE, type = 'l', main = NULL)

# Manuális, szép verzió a videóban.3:22/8:30

# könnyebb. factroextra package.  
fviz_eig(pca.prcomp)

# Plot verziók  
# basic  
biplot(pca.prcomp, scaling = "symmetric")  
# A fenti módosítása # fuuu. ez nagyon fura ábra lett nekem.   
fviz_pca_biplot(pca.prcomp, repel = TRUE,  
                cor.var = "#2e9fdf", # Variables color  
                col.ind = "#696969") # Individuals color

# kiválaszthatom, hogy mely dimenziókat akarok vizualizálni.   
# Most az 1. és 3. PC-t választottam ki.  
plot(pca.prcomp$x[,1], pca.prcomp$x[,3])

# Most jön a bekarikázós plot. Kell a ffplot 2 ésvagy a ggfortify package  
pca.prcomp.df <- data.frame(pca.prcomp$x) # A PC-ket léthozza, mint oszlopok, a mintákat pedig sorokba rendezi  
pca.prcomp.df$plotx <- pca.prcomp.df[,1] # A PC1-t létrehozza, mint plotx oszlop (x tengely)  
pca.prcomp.df$ploty <- pca.prcomp.df[,2] # A PC2-t létrehozza, mint plotx oszlop (y tengely)

# Attól függően, hogy a mért paraméterek között vagy épp a minták akarok hasonlóságokat kimutatni tranzponálni kell az adatok. 

# CO2  
co2_level = as.character(df$co2_level) # Hozzáad egy kategórikus oszlopot  
pca.prcomp.df$co2_level <- co2_level   # Hozzáad egy kategórikus oszlopot

pca.prcomp.plot <- ggplot(pca.prcomp.df, aes(x=plotx, y=ploty, color=co2_level)) +  
  geom_point() +   
  ggtitle("PCA with CO2 level") +   
  xlab("PC1") + ylab("PC2") +  
  coord_fixed(ratio = 1) +   
  theme_bw() + theme(aspect.ratio=1) + theme(panel.grid = element_blank()) +  
  stat_ellipse(geom = "polygon", aes(fill = after_scale(alpha(colour, 0.3))),  
               data = pca.prcomp.df[pca.prcomp.df$co2_level != "versicolor",])  
pca.prcomp.plot

# CO2 színes kitöltés nélkül  
pca.prcomp.plot <- ggplot(pca.prcomp.df, aes(x=plotx, y=ploty, color=co2_level)) +  
  geom_point() +   
  ggtitle(expression("PCA with CO"[2] * " level")) +   
  xlab("PC1") + ylab("PC2") +  
  coord_fixed(ratio = 1) +   
  theme_bw() + theme(aspect.ratio=1) + theme(panel.grid = element_blank()) +  
  stat_ellipse()  
pca.prcomp.plot

