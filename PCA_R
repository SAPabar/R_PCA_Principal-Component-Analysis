n_level = as.character(df$n_level) # Hozzáad egy kategórikus oszlopot  
pca.prcomp.df$n_level <- n_level   # Hozzáad egy kategórikus oszlopot

pca.prcomp.plot <- ggplot(pca.prcomp.df, aes(x=plotx, y=ploty, color=n_level)) +  
