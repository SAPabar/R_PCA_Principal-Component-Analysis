pca$rotation #Eigenvectors   
pca$center  
pca$scale # 1-2 változó nagyon kilóg. ezeket lehet át kéne alakítani  
pca$x

# Scree Plot of Variance   
fviz_eig(pca, addlabels = TRUE, ylim = c(0, 50))  
